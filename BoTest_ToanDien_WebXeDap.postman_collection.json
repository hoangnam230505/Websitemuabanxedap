              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "TC-AUTH-09: Chặn truy cập profile khi thiếu Bearer Token",
          "event": [
