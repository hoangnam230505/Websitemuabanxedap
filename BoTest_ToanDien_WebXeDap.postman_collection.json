{
    "info": {
        "_postman_id": "8b6d2e5b-633a-4bc1-8ba4-891805efb1f2",
        "name": "Kiểm Thử Toàn Diện Web Mua Bán Xe Đạp - UTH",
        "description": "Bộ kịch bản kiểm thử API tự động toàn diện bao phủ 4 phân hệ cốt lõi: Auth, Catalog/Search, Bike Posts, Orders/Payments theo chuẩn 7 chương môn Kiểm thử phần mềm.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Phân Hệ Xác Thực & Tài Khoản (Auth & Profile)",
            "item": [
                {
                    "name": "TC-AUTH-01: Đăng ký tài khoản mới thành công",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"name\": \"Sinh Vien Test\", \"email\": \"tester_new@gmail.com\", \"password\": \"Password123\"}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 201 Created or 200', function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                                    "});",
                                    "pm.test('Response chứa thông điệp thành công', function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.success).to.be.true;",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "TC-AUTH-02: Đăng ký thất bại - Mật khẩu dưới biên (BVA min-1 = 5 ký tự)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"name\": \"Test BVA\", \"email\": \"test_bva_5@gmail.com\", \"password\": \"12345\"}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 400 Bad Request', function () {",
                                    "    pm.response.to.have.status(400);",
                                    "});",
                                    "pm.test('Thông báo lỗi mật khẩu ít nhất 6 ký tự', function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.success).to.be.false;",
                                    "    pm.expect(jsonData.message).to.include('6 ký tự');",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "TC-AUTH-06: Đăng nhập thành công và lưu JWT Token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"email\": \"admin@gmail.com\", \"password\": \"password\"}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200 OK', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "pm.test('Trả về token JWT hợp lệ', function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.data).to.have.property('token');",
                                    "    pm.environment.set('authToken', jsonData.data.token);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "TC-AUTH-07: Đăng nhập thất bại khi nhập sai mật khẩu",
