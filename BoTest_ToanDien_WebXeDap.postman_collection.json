        {
            "name": "3. Phân Hệ Đăng Tin & Bài Đăng (Bike Posts)",
            "item": [
                {
                    "name": "TC-POST-01: Đăng tin bán xe mới thành công",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"title\": \"Xe \\u0111\\u1ea1p th\\u1ec3 thao Trek Marlin 7 ch\\u00ednh h\\u00e3ng\", \"description\": \"Xe l\\u01b0\\u1edbt \\u0111i \\u0111\\u01b0\\u1ee3c 50km, b\\u1ea3o h\\u00e0nh ch\\u00ednh h\\u00e3ng 12 th\\u00e1ng\", \"price\": 9500000, \"category_id\": 1, \"brand_id\": 1}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/bikes",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "bikes"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 201 Created', function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "pm.test('Lưu lại post_id mới tạo', function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.data).to.have.property('post_id');",
                                    "    pm.environment.set('createdPostId', jsonData.data.post_id);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "TC-POST-02: Đăng tin thất bại khi thiếu thông tin bắt buộc",
