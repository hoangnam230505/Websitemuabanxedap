{
  "info": {
    "_postman_id": "bva-testing-website-ban-xe-dap",
    "name": "BVA_Testing_WebsiteBanXeDap",
    "description": "Bộ Test Case Phân tích giá trị biên (Boundary Value Analysis - BVA) kiểm thử chức năng Đăng ký tài khoản (Độ dài mật khẩu) theo chuẩn môn Kiểm thử phần mềm.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC_BVA_01 [min - 1] Password 5 ký tự (Không hợp lệ)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"[BVA min - 1] Trả về mã HTTP 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"[BVA min - 1] Báo lỗi mật khẩu phải có ít nhất 6 ký tự\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.false;",
              "    pm.expect(jsonData.message).to.include(\"ít nhất 6 ký tự\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Nguyen Van A\",\n  \"email\": \"test_bva_5chars_{{$timestamp}}@gmail.com\",\n  \"password\": \"12345\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "auth", "register"]
        },
        "description": "Kiểm thử giá trị dưới biên dưới: Password = 5 ký tự (min - 1). Kết quả kỳ vọng: Bị từ chối với mã 400."
      }
    },
    {
